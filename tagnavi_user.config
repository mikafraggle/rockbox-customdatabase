#! rockbox/tagbrowser/2.0

# Please note that modifying any menu labels/titles may result in them
# not being translated or voiced.

#listing of albums without "the"
#listing of artist without "the"

# Basic format declarations
%format "fmt_title"       "(%s-%s) %s" grouping ensemble title
#just trying to see what things are tagged as
#grouping seems to be working, ensemble (albums sorted) doesn't
#%format "fmt_title"       "%d.%02d. %s - %02d:%02d" discnum tracknum title Lm Ls ? discnum > "0"
#%format "fmt_title"       "%02d. %s - %02d:%02d" tracknum title Lm Ls ? tracknum > "0"



#line for only albums and can random play one
#filter for album never played
#filter for artist never played

%menu_start "albumartistsort" "filter the album"
#"all albums starting w the" -> album ? album ^ The  -> title = "fmt_title"
#"all albums starting w the2" -> album ? album ^ The -> album -> title = "fmt_title"
#"albums excluding The" -> album ? album !~ The -> title = "fmt_title"
"aa to albumsort" -> albumartist -> ensemble -> title = "fmt_title" #sorted first to sorted first to title
"artistsort to albumsort" -> grouping -> ensemble -> title = "fmt_title" #did i accidentally tag grouping and ensemble the same? sorted last name, sorted first name, songs
"ensemble to ensemble" -> ensemble -> grouping -> title = "fmt_title" #sorted first name, sorted last name
"group to title" -> grouping -> title = "fmt_title" #sorted by last name to songs
"ensemble to title" -> ensemble -> title = "fmt_title" #sorted by first to songs
"group to title" -> grouping -> title = "fmt_title"


# Define the title of the main menu
%menu_start "main" "Database"
"Album Artist sort" ==> "albumartistsort"
"Album Artist" -> albumartist   -> album  -> title = "fmt_title"
"Artist"   -> canonicalartist   -> album  -> title = "fmt_title"
"Shuffle Songs" ~> title = "fmt_title"
"aa to albumsort" -> albumartist -> ensemble -> title = "fmt_title" #sorted first to sorted first to title
"artistsort to albumsort" -> grouping -> ensemble -> title = "fmt_title" #did i accidentally tag grouping and ensemble the same? sorted last name, sorted first name, songs
"ensemble to ensemble" -> ensemble -> grouping -> title = "fmt_title" #sorted first name, sorted last name
"group to title" -> grouping -> title = "fmt_title" #sorted by last name to songs
"ensemble to title" -> ensemble -> title = "fmt_title" #sorted by first to songs
"group to title" -> grouping -> title = "fmt_title"


# And finally set main menu as our root menu
%root_menu "main"
